# Optional local AI proxy for development only. GitHub Pages needs no environment
# configuration or database and uses the existing protected Kimi relay directly.
PORT=4237
ALIBABA_API_KEY=
ALIBABA_BASE_URL=https://token-plan.maas.qianwenaiapi.com/compatible-mode/v1
